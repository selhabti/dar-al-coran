# --- Base de données Neon ---
# Chaine poolée (utilisée par l'application). Le hostname contient "-pooler".
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Chaine directe (utilisée par les migrations). Sans "-pooler".
DIRECT_DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Neon Auth ---
NEON_AUTH_BASE_URL=
# Secret de signature des cookies (>= 32 caracteres). Generer avec: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Sans le @
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- Application ---
# URL publique (HTTPS) utilisee pour enregistrer le webhook Telegram
NEXT_PUBLIC_APP_URL=http://localhost:3000
